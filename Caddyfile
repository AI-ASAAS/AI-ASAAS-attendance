attendance.ai-asaas.com {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode zstd gzip
	reverse_proxy host.docker.internal:7443 host.docker.internal:7777 host.docker.internal:3001 {
		lb_policy first
		lb_try_duration 3s
		fail_duration 5s
	}
}

