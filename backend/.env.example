HOST=127.0.0.1
PORT=5000
NODE_ENV=development

# SQLite Database (Embedded, zero-latency, crash-safe WAL)
SQLITE_PATH=../database/asas.db

# QR Token & Security Secret (At least 32 characters)
QR_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Optional Initial Super Admin Bootstrap (Used on first launch if database is fresh)
SETUP_ADMIN_IDENTIFIER=admin
SETUP_ADMIN_PASSWORD=Admin@123456

WEB_ORIGIN=http://localhost:3000

# Google / Gmail SMTP Settings for Automated Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="نظام أساس للحضور" <your_email@gmail.com>
